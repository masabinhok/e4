# Local Mongo from `docker compose up -d` at the repo root
DATABASE_URL=mongodb://localhost:27017/e4
# Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Optional (defaults shown)
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
PORT=5000
# Number of proxies in front of the API, so rate limits see the real client IP.
# 0 locally. Set it in production after checking (see README).
TRUST_PROXY_HOPS=0
# Shared with the web app's /api proxy, so the API can trust the visitor IP it forwards.
# Generate with: openssl rand -base64 32 (any value works locally, as long as both sides match)
PROXY_SECRET=change-me-proxy
