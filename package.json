{
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  },
  "scripts": {
    "prepare": "husky",
    "build:all": "npm --prefix api run build && npm --prefix web run build"
  },
  "lint-staged": {
    "api/**/*.ts": [
      "npm --prefix api run lint:fix",
      "npm --prefix api run format"
    ],
    "web/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix web run lint",
      "npm --prefix web run format"
    ]
  }
}
